# --- Container deployment (docker compose) ---
# On the Air this file lives as .env in ~/services/fossil.kelostrada.pl/ only.
DB_ROOT_PASSWORD=change_me
DB_USERNAME=fossil
DB_PASSWORD=change_me
DB_DATABASE=fossil
PORT=4003
VERSION=latest
TZ=Europe/Warsaw

# --- App ---
# Shared-hosting layout also supports DB_HOST here; in compose it's fixed to "db".
DISCORD_WEBHOOK_URL=your_discord_webhook_url
